{
    "info": {
        "name": "FizzBuzz API",
        "description": "Collection to manually test the FizzBuzz API endpoint(s).\n\nBefore running requests, make sure `base_url` points to your running container (see the `base_url` collection variable).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000",
            "description": "Adjust this to match the port exposed by your docker-compose setup (e.g. http://localhost:8080 if mapped differently)."
        },
        {
            "key": "int1",
            "value": "3"
        },
        {
            "key": "int2",
            "value": "5"
        },
        {
            "key": "limit",
            "value": "15"
        },
        {
            "key": "str1",
            "value": "fizz"
        },
        {
            "key": "str2",
            "value": "buzz"
        }
    ],
    "item": [
        {
            "name": "FizzBuzz",
            "item": [
                {
                    "name": "GET /fizzbuzz - success",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz?int1={{int1}}&int2={{int2}}&limit={{limit}}&str1={{str1}}&str2={{str2}}",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"],
                            "query": [
                                { "key": "int1", "value": "{{int1}}" },
                                { "key": "int2", "value": "{{int2}}" },
                                { "key": "limit", "value": "{{limit}}" },
                                { "key": "str1", "value": "{{str1}}" },
                                { "key": "str2", "value": "{{str2}}" }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response has a \"result\" array', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json).to.have.property('result');",
                                    "    pm.expect(json.result).to.be.an('array');",
                                    "});",
                                    "",
                                    "pm.test('Result length matches limit', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.result.length).to.eql(parseInt(pm.collectionVariables.get('limit')));",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "POST /fizzbuzz - success",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"int1\": {{int1}},\n  \"int2\": {{int2}},\n  \"limit\": {{limit}},\n  \"str1\": \"{{str1}}\",\n  \"str2\": \"{{str2}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response has a \"result\" array', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json).to.have.property('result');",
                                    "    pm.expect(json.result).to.be.an('array');",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "FizzBuzz - validation errors",
            "item": [
                {
                    "name": "GET /fizzbuzz - missing params",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 400', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "GET /fizzbuzz - int1 equals int2",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz?int1=3&int2=3&limit=15&str1=fizz&str2=buzz",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"],
                            "query": [
                                { "key": "int1", "value": "3" },
                                { "key": "int2", "value": "3" },
                                { "key": "limit", "value": "15" },
                                { "key": "str1", "value": "fizz" },
                                { "key": "str2", "value": "buzz" }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 400', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "GET /fizzbuzz - negative limit",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz?int1=3&int2=5&limit=-1&str1=fizz&str2=buzz",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"],
                            "query": [
                                { "key": "int1", "value": "3" },
                                { "key": "int2", "value": "5" },
                                { "key": "limit", "value": "-1" },
                                { "key": "str1", "value": "fizz" },
                                { "key": "str2", "value": "buzz" }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 400', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "GET /fizzbuzz - empty str1",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz?int1=3&int2=5&limit=15&str1=&str2=buzz",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"],
                            "query": [
                                { "key": "int1", "value": "3" },
                                { "key": "int2", "value": "5" },
                                { "key": "limit", "value": "15" },
                                { "key": "str1", "value": "" },
                                { "key": "str2", "value": "buzz" }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 400', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "POST /fizzbuzz - malformed JSON body",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "not valid json"
                        },
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 400 (not 500)', function () {",
                                    "    pm.response.to.have.status(400);",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Statistics",
            "item": [
                {
                    "name": "1. GET /fizzbuzz - hit A (int1=3, int2=5)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz?int1=3&int2=5&limit=15&str1=fizz&str2=buzz",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"],
                            "query": [
                                { "key": "int1", "value": "3" },
                                { "key": "int2", "value": "5" },
                                { "key": "limit", "value": "15" },
                                { "key": "str1", "value": "fizz" },
                                { "key": "str2", "value": "buzz" }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "2. GET /fizzbuzz - hit A again (should become the most frequent)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz?int1=3&int2=5&limit=15&str1=fizz&str2=buzz",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"],
                            "query": [
                                { "key": "int1", "value": "3" },
                                { "key": "int2", "value": "5" },
                                { "key": "limit", "value": "15" },
                                { "key": "str1", "value": "fizz" },
                                { "key": "str2", "value": "buzz" }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "3. GET /fizzbuzz - hit B (int1=2, int2=7, only once)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/fizzbuzz?int1=2&int2=7&limit=15&str1=foo&str2=bar",
                            "host": ["{{base_url}}"],
                            "path": ["fizzbuzz"],
                            "query": [
                                { "key": "int1", "value": "2" },
                                { "key": "int2", "value": "7" },
                                { "key": "limit", "value": "15" },
                                { "key": "str1", "value": "foo" },
                                { "key": "str2", "value": "bar" }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "4. GET /statistics - most frequent should be hit A (2 hits)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/statistics",
                            "host": ["{{base_url}}"],
                            "path": ["statistics"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response has \"parameters\" and \"hits\"', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json).to.have.property('parameters');",
                                    "    pm.expect(json).to.have.property('hits');",
                                    "});",
                                    "",
                                    "pm.test('Most frequent is hit A (int1=3, int2=5) with 2 hits', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.parameters.int1).to.eql(3);",
                                    "    pm.expect(json.parameters.int2).to.eql(5);",
                                    "    pm.expect(json.hits).to.eql(2);",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Statistics - no data",
            "item": [
                {
                    "name": "GET /statistics - before any /fizzbuzz call",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/statistics",
                            "host": ["{{base_url}}"],
                            "path": ["statistics"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('parameters is null and hits is 0 when no data yet', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.parameters).to.eql(null);",
                                    "    pm.expect(json.hits).to.eql(0);",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Health",
            "item": [
                {
                    "name": "GET /health - healthy",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/health",
                            "host": ["{{base_url}}"],
                            "path": ["health"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response reports ok status', function () {",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.status).to.eql('ok');",
                                    "    pm.expect(json.redis).to.eql('ok');",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
